Object.assign(CORE.hi, {"Your Name": "आपका नाम", "Phone Number": "फ़ोन नंबर", "Email Address": "ईमेल पता", "Tell us about your project...": "अपने प्रोजेक्ट के बारे में बताएँ..."});
Object.assign(CORE.mr, {"Your Name": "तुमचे नाव", "Phone Number": "फोन क्रमांक", "Email Address": "ईमेल पत्ता", "Tell us about your project...": "तुमच्या प्रकल्पाबद्दल सांगा..."});
Object.assign(CORE.gu, {"Your Name": "તમારું નામ", "Phone Number": "ફોન નંબર", "Email Address": "ઈમેઇલ સરનામું", "Tell us about your project...": "તમારા પ્રોજેક્ટ વિશે જણાવો..."});
const coreKeys=new Set(Object.values(CORE).flatMap(dictionary=>Object.keys(dictionary)));
const HERO={en:['Creative environments','for co-working and office spaces.'],zh:['打造创意办公环境','服务协作空间与办公室。'],ja:['創造的なワークスペースを','オフィスと協働のために。'],ko:['창의적인 업무 공간을','협업과 사무를 위해.'],...Object.fromEntries(Object.entries(HERO_EXTRA).map(([k,v])=>[k,v]))};
const nodes=[];const seen=new WeakSet();
function collect(){
  const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT,{acceptNode:node=>{
    const parent=node.parentElement;if(!parent||/^(SCRIPT|STYLE|TEXTAREA)$/.test(parent.tagName)||parent.closest('.hero-title,.lang-switch,.lang-select'))return NodeFilter.FILTER_REJECT;
    return node.nodeValue.trim()?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT;
  }});
  let node;while((node=walker.nextNode())){
    if(seen.has(node))continue;seen.add(node);
    const key=node.nodeValue.trim();if(map[key]||coreKeys.has(key))nodes.push([node,key,node.nodeValue.split(key)[0],node.nodeValue.split(key).slice(1).join(key)]);
  }
}
function setHero(code){
  const h=document.getElementById('hero-title');if(!h)return;const lines=HERO[code]||HERO.en;let delay=0;
  const line=value=>[...value].map(ch=>ch===' '?' ':`<span class="char" style="transition-delay:${(delay++)*.018}s">${ch}</span>`).join('');
  h.innerHTML=line(lines[0])+'<br>'+line(lines[1]);requestAnimationFrame(()=>h.classList.add('in'));
}
const PH={'Your Name':'name','Phone Number':'phone','Email Address':'email','Tell us about your project...':'project'};
function apply(code){
  const i=L.indexOf(code); collect();
  nodes.forEach(([n,k,pre,post])=>{ if(n.isConnected){const translated=(CORE[code]&&CORE[code][k])||(i>0&&map[k]&&map[k][i])||k;n.nodeValue=pre+translated+post} });
  document.querySelectorAll('input[placeholder],textarea[placeholder]').forEach(el=>{
    if(!el.dataset.en)el.dataset.en=el.getAttribute('placeholder'); const r=map[el.dataset.en];
    el.setAttribute('placeholder',(CORE[code]&&CORE[code][el.dataset.en])||(i>0&&r?r[i]:el.dataset.en))});
  setHero(code);
  document.documentElement.lang=({en:'en',hi:'hi',mr:'mr',bn:'bn',ta:'ta',te:'te',gu:'gu',ur:'ur',ar:'ar',zh:'zh-CN',ja:'ja',ko:'ko',es:'es',fr:'fr',de:'de',pt:'pt'})[code]; document.documentElement.dir=code==='ar'||code==='ur'?'rtl':'ltr'; document.querySelectorAll('.lang-select').forEach(picker=>picker.value=code);
  
  try{localStorage.setItem('mfms-lang',code)}catch(e){}
}
document.querySelectorAll('.lang-select').forEach(picker=>picker.addEventListener('change',event=>{if(ALL.includes(event.target.value))apply(event.target.value)}));
let saved='en'; try{saved=localStorage.getItem('mfms-lang')||'en'}catch(e){}
if(ALL.includes(saved)&&saved!=='en')setTimeout(()=>apply(saved),0); else document.querySelectorAll('.lang-select').forEach(picker=>picker.value='en');
})();
</script>
