/* ============ gold dust particle canvas in hero ============ */
const canvas = document.getElementById('spark-canvas');
const ctx = canvas.getContext('2d');
let W, H, particles = [];
function resizeCanvas(){
  W = canvas.width = canvas.offsetWidth;
  H = canvas.height = canvas.offsetHeight;
}
function initParticles(){
  particles = Array.from({length:60}, ()=>({
    x: Math.random()*W,
    y: Math.random()*H + H*0.2,
    r: Math.random()*1.8 + 0.6,
    speed: Math.random()*0.35 + 0.08,
    drift: (Math.random()-0.5)*0.3,
    alpha: Math.random()*0.5 + 0.2
  }));
}
function animateParticles(){
  ctx.clearRect(0,0,W,H);
  particles.forEach(p=>{
    p.y -= p.speed; p.x += Math.sin(p.y*0.01)*p.drift;
    if (p.y < -10) { p.y = H + 10; p.x = Math.random()*W; }
    ctx.beginPath();
    const grad = ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*4);
    grad.addColorStop(0, `rgba(241,216,121,${p.alpha})`);
    grad.addColorStop(1, 'rgba(241,216,121,0)');
    ctx.fillStyle = grad;
    ctx.arc(p.x,p.y,p.r*4,0,Math.PI*2);
    ctx.fill();
  });
  requestAnimationFrame(animateParticles);
}
window.addEventListener('resize', ()=>{ resizeCanvas(); initParticles(); });
resizeCanvas(); initParticles(); animateParticles();
</script>
<script>
(function(){
  const INLINE_MEDIA = [
    "assets/video/matrix-project-01.mp4","assets/video/matrix-project-02.mp4","assets/video/matrix-project-03.mp4",
    "assets/video/matrix-project-04.mp4","assets/video/matrix-project-05.mp4","assets/video/matrix-project-06.mp4","assets/video/matrix-project-07.mp4"
  ];
  const INLINE_IMAGES = ["assets/images/clinic-workplace.webp","assets/images/matrix-team-office.jpg","assets/images/corporate-reception.jpg","assets/images/modern-office.jpg","assets/images/matrix-office-showcase.webp"];
  document.querySelectorAll('img[data-inline-image]').forEach(image=>{
    const index=Number(image.dataset.inlineImage); if(INLINE_IMAGES[index]) image.src=INLINE_IMAGES[index];
  });
  const videos=[...document.querySelectorAll('video')];
  videos.forEach(video=>{video.muted=true;video.playsInline=true;video.setAttribute('playsinline','');});
  function playVideo(video){
    const source=video.querySelector('source[data-inline-media]');
    if(source&&!source.dataset.loaded){const index=Number(source.dataset.inlineMedia);if(INLINE_MEDIA[index]){source.src=INLINE_MEDIA[index];source.dataset.loaded='true';video.load();}}
    const p=video.play(); if(p&&p.catch)p.catch(()=>{});
  }
  if('IntersectionObserver' in window){
    const io=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)playVideo(entry.target);else entry.target.pause();}),{rootMargin:'140px 0px',threshold:0.01});
    videos.forEach(video=>io.observe(video));
  } else videos.forEach(playVideo);
})();
</script>
