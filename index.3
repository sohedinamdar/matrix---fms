<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Matrix FMS | Commercial Interiors &amp; Facility Management, Pune</title>
<meta name="description" content="Matrix FMS India Pvt. Ltd. delivers commercial interiors, turnkey project execution, engineering systems and facility management for workplaces across Pune and Maharashtra.">
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Poppins:wght@300;400;500;600;700&display=swap');

:root{
  --gold:#D4AF37;
  --gold-light:#F1D879;
  --bronze:#8A5A33;
  --bronze-dark:#4E3119;
  --cream:#FFF8E8;
  --sand:#E9DAB3;
  --ink:#231A10;
  --text-soft:#5B4A36;
  --radius:14px;
  --ease:cubic-bezier(.22,1,.36,1);
}

*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
html,body{width:100%;background:var(--cream);-ms-overflow-style:none;scrollbar-width:none;}
::-webkit-scrollbar{display:none;width:0;}

body{
  font-family:'Poppins',sans-serif;
  color:var(--text-soft);
  overflow-x:hidden;
  background:var(--cream);
}

h1,h2,h3,.logo-word{font-family:'Playfair Display',serif;}

a{color:inherit;text-decoration:none;}
img{display:block;max-width:100%;}
section{scroll-margin-top:90px;}

/* ---------- custom cursor (fine pointers only) ---------- */
body.has-fine-pointer, body.has-fine-pointer *{cursor:none !important;}
.cursor-inner{
  position:fixed;top:0;left:0;width:7px;height:7px;
  border:2px solid var(--gold-light);border-radius:50%;
  transform:translate(-50%,-50%);pointer-events:none;z-index:9999;
  display:none;
}
.cursor-outer{
  position:fixed;top:0;left:0;width:38px;height:38px;
  border:1.5px solid rgba(212,175,55,.55);border-radius:50%;
  transform:translate(-50%,-50%);pointer-events:none;z-index:9998;
  transition:width .3s,height .3s,background .3s,border-color .3s;
  display:none;
}
body.has-fine-pointer .cursor-inner,
body.has-fine-pointer .cursor-outer{display:block;}
.cursor-outer.hover{width:58px;height:58px;background:rgba(212,175,55,.1);border-color:var(--gold);}

/* ---------- scroll progress ---------- */
#progress-bar{
  position:fixed;top:0;left:0;height:3px;width:0%;
  background:linear-gradient(90deg,var(--bronze),var(--gold));
  z-index:10000;transition:width .08s linear;
}

/* ---------- header ---------- */
header{
  position:fixed;top:0;left:0;width:100%;z-index:500;
  display:flex;align-items:center;justify-content:space-between;
  padding:26px 60px;transition:all .4s var(--ease);
}
header.scrolled{
  padding:14px 60px;background:rgba(18,13,8,.82);backdrop-filter:blur(10px);
  box-shadow:0 8px 30px rgba(0,0,0,.25);
}
.brand{display:flex;flex-direction:column;line-height:1;}
.logo-word{font-size:22px;letter-spacing:3px;color:var(--gold-light);font-weight:600;}
header:not(.scrolled) .logo-word{color:var(--ink);}
.logo-sub{font-size:9px;letter-spacing:4px;text-transform:uppercase;color:var(--bronze);margin-top:4px;}
header.scrolled .logo-sub{color:var(--sand);}

nav.main-nav{display:flex;align-items:center;gap:30px;}
nav.main-nav a{
  font-size:12px;letter-spacing:1.5px;text-transform:uppercase;font-weight:500;
  color:var(--ink);position:relative;padding-bottom:4px;
}
header.scrolled nav.main-nav a{color:var(--cream);}
nav.main-nav a::after{
  content:'';position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--gold);
  transition:width .35s var(--ease);
}
nav.main-nav a:hover::after{width:100%;}

.header-actions{display:flex;align-items:center;gap:16px;}
.btn-gold{
  display:inline-flex;align-items:center;gap:8px;padding:12px 26px;border-radius:30px;
  background:linear-gradient(120deg,var(--gold),var(--bronze));color:#1b1206;
  font-size:12px;font-weight:600;letter-spacing:1px;text-transform:uppercase;
  transition:transform .3s var(--ease),box-shadow .3s var(--ease);
}
.btn-gold:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(212,175,55,.35);}
.btn-outline{
  display:inline-flex;align-items:center;gap:8px;padding:11px 24px;border-radius:30px;
  border:1px solid var(--gold);color:var(--gold-light);font-size:12px;font-weight:600;
  letter-spacing:1px;text-transform:uppercase;transition:all .3s var(--ease);
}
.btn-outline:hover{background:rgba(212,175,55,.12);}

.nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;z-index:600;}
.nav-toggle span{width:26px;height:2px;background:var(--ink);transition:.3s;}
header.scrolled .nav-toggle span{background:var(--cream);}

/* ---------- hero ---------- */
.hero{
  position:relative;min-height:100vh;display:flex;align-items:center;
  padding:0 60px;overflow:hidden;background:var(--ink);
}
.hero-bg{
  position:absolute;inset:0;background-size:cover;background-position:center;
  filter:brightness(.42) saturate(1.05);transform:scale(1.08);
}
.hero-gradient{
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(18,13,8,.55) 0%,rgba(18,13,8,.35) 40%,rgba(18,13,8,.92) 100%),
             linear-gradient(100deg,rgba(18,13,8,.75) 10%,rgba(18,13,8,.15) 55%);
}
#spark-canvas{position:absolute;inset:0;pointer-events:none;}
.hero-content{position:relative;z-index:3;max-width:760px;}
.hero-eyebrow{
  font-size:12px;letter-spacing:5px;text-transform:uppercase;color:var(--gold-light);
  margin-bottom:22px;opacity:0;animation:fadeUp .9s .2s var(--ease) forwards;
}
.hero-title{
  font-size:clamp(40px,6vw,76px);line-height:1.08;color:var(--cream);font-weight:600;margin-bottom:26px;
}
.hero-title .char{display:inline-block;opacity:0;transform:translateY(40px);filter:blur(10px);
  transition:opacity .8s var(--ease),transform .8s var(--ease),filter .8s var(--ease);}
.hero-title.in .char{opacity:1;transform:translateY(0);filter:blur(0);}
.hero-desc{
  font-size:16px;line-height:1.8;color:var(--sand);max-width:520px;margin-bottom:38px;
  opacity:0;transform:translateY(20px);animation:fadeUp .9s .9s var(--ease) forwards;
}
.hero-ctas{display:flex;gap:18px;flex-wrap:wrap;opacity:0;transform:translateY(20px);animation:fadeUp .9s 1.1s var(--ease) forwards;}
@keyframes fadeUp{to{opacity:1;transform:translateY(0);}}

.hero-stats{
  position:relative;z-index:3;display:flex;gap:60px;margin-top:70px;flex-wrap:wrap;
}
.stat .num{font-family:'Playfair Display',serif;font-size:40px;color:var(--gold-light);}
.stat .label{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--sand);margin-top:6px;}

.scroll-cue{
  position:absolute;bottom:30px;left:60px;z-index:3;display:flex;align-items:center;gap:10px;
  font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--sand);
}
.scroll-line{width:1px;height:40px;background:linear-gradient(var(--gold),transparent);
  animation:scrollLine 2s infinite var(--ease);}
@keyframes scrollLine{0%{transform:scaleY(0);transform-origin:top;}50%{transform:scaleY(1);transform-origin:top;}
  51%{transform-origin:bottom;}100%{transform:scaleY(0);transform-origin:bottom;}}

/* ---------- generic section styling ---------- */
.section{padding:120px 60px;}
.section.sand{background:var(--sand);}
.section.dark{background:var(--ink);color:var(--sand);}
.eyebrow{
  font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--bronze);margin-bottom:16px;
}
.section.dark .eyebrow{color:var(--gold-light);}
.section-title{font-size:clamp(30px,4vw,48px);color:var(--ink);font-weight:600;margin-bottom:26px;max-width:700px;}
.section.dark .section-title{color:var(--cream);}
.section-lead{font-size:16px;line-height:1.8;max-width:640px;margin-bottom:10px;}

.reveal{opacity:0;transform:translateY(40px);transition:opacity .9s var(--ease),transform .9s var(--ease);}
.reveal.in-view{opacity:1;transform:translateY(0);}

/* ---------- about ---------- */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;}
.about-img-wrap{position:relative;}
.about-img-wrap img{border-radius:var(--radius);width:100%;height:520px;object-fit:cover;}
.about-img-badge{
  position:absolute;bottom:-28px;left:-28px;background:var(--ink);color:var(--gold-light);
  padding:24px 30px;border-radius:var(--radius);box-shadow:0 20px 40px rgba(0,0,0,.25);
}
.about-img-badge .num{font-family:'Playfair Display',serif;font-size:34px;}
.about-img-badge .label{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--sand);margin-top:4px;}
.about-points{list-style:none;margin-top:26px;display:grid;gap:14px;}
.about-points li{display:flex;gap:12px;font-size:14.5px;line-height:1.6;}
.about-points li::before{content:'';flex:0 0 7px;width:7px;height:7px;border-radius:50%;background:var(--gold);margin-top:7px;}

/* ---------- services ---------- */
.services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:50px;}
.service-card{
  background:var(--cream);border:1px solid rgba(138,90,51,.18);border-radius:var(--radius);
  padding:34px 26px;transition:transform .4s var(--ease),box-shadow .4s var(--ease),border-color .4s;
}
.service-card:hover{transform:translateY(-8px);box-shadow:0 20px 36px rgba(138,90,51,.18);border-color:var(--gold);}
.service-icon{font-size:30px;margin-bottom:18px;}
.service-card h3{font-size:17px;color:var(--ink);margin-bottom:10px;font-family:'Poppins',sans-serif;font-weight:600;}
.service-card p{font-size:13.5px;line-height:1.7;}

/* ---------- gallery ---------- */
.gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:220px;gap:16px;margin-top:50px;}
.gallery-grid .g-item:nth-child(1){grid-column:span 2;grid-row:span 2;}
.gallery-grid .g-item:nth-child(6){grid-column:span 2;}
.g-item{position:relative;border-radius:var(--radius);overflow:hidden;cursor:pointer;}
.g-item img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease);}
.g-item:hover img{transform:scale(1.08);}
.g-overlay{
  position:absolute;inset:0;background:linear-gradient(0deg,rgba(18,13,8,.75),transparent 55%);
  display:flex;align-items:flex-end;padding:16px;opacity:0;transition:opacity .35s;
}
.g-item:hover .g-overlay{opacity:1;}
.g-overlay span{color:var(--cream);font-size:12px;letter-spacing:1px;text-transform:uppercase;}

#lightbox{
  position:fixed;inset:0;background:rgba(10,7,4,.95);z-index:9000;display:none;
  align-items:center;justify-content:center;flex-direction:column;
}
#lightbox.open{display:flex;}
#lightbox img{max-width:84vw;max-height:76vh;border-radius:8px;}
#lightbox .lb-close{position:absolute;top:30px;right:40px;font-size:30px;color:var(--cream);cursor:pointer;}
#lightbox .lb-nav{display:flex;gap:40px;margin-top:24px;}
#lightbox .lb-nav span{color:var(--gold-light);font-size:14px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;}

/* ---------- pricing ---------- */
.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:50px;}
.price-card{
  background:var(--ink);border-radius:var(--radius);overflow:hidden;color:var(--sand);
  display:flex;flex-direction:column;transition:transform .4s var(--ease);position:relative;
}
.price-card.popular{border:1px solid var(--gold);transform:scale(1.03);}
.price-card:hover{transform:translateY(-10px);}
.price-card.popular:hover{transform:scale(1.03) translateY(-10px);}
.price-tag{position:absolute;top:18px;right:18px;background:var(--gold);color:#1b1206;font-size:10px;
  letter-spacing:1px;text-transform:uppercase;padding:6px 12px;border-radius:20px;font-weight:700;}
.price-img{height:190px;overflow:hidden;}
.price-img img{width:100%;height:100%;object-fit:cover;}
.price-body{padding:30px;}
.price-body h3{color:var(--cream);font-size:22px;margin-bottom:10px;}
.price-body p{font-size:13.5px;line-height:1.7;margin-bottom:18px;}
.price-feats{list-style:none;display:grid;gap:10px;margin-bottom:24px;}
.price-feats li{font-size:13px;display:flex;gap:10px;}
.price-feats li::before{content:'✓';color:var(--gold-light);font-weight:700;}

/* ---------- testimonials ---------- */
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:50px;}
.testi-card{
  background:var(--cream);border-radius:var(--radius);padding:30px;
  border:1px solid rgba(138,90,51,.18);
}
.section.dark .testi-card{background:rgba(255,248,232,.05);border-color:rgba(212,175,55,.2);}
.testi-stars{color:var(--gold);letter-spacing:3px;margin-bottom:14px;}
.testi-card p{font-size:14px;line-height:1.8;font-style:italic;margin-bottom:22px;}
.testi-person{display:flex;align-items:center;gap:14px;}
.testi-person img{width:46px;height:46px;border-radius:50%;object-fit:cover;}
.testi-person .name{font-size:14px;color:var(--ink);font-weight:600;}
.section.dark .testi-person .name{color:var(--cream);}
.testi-person .role{font-size:11.5px;color:var(--bronze);}
.section.dark .testi-person .role{color:var(--gold-light);}

/* ---------- client marquee ---------- */
.marquee-wrap{overflow:hidden;margin-top:50px;position:relative;}
.marquee-wrap::before,.marquee-wrap::after{content:'';position:absolute;top:0;bottom:0;width:80px;z-index:2;}
.marquee-wrap::before{left:0;background:linear-gradient(90deg,var(--cream),transparent);}
.marquee-wrap::after{right:0;background:linear-gradient(-90deg,var(--cream),transparent);}
.marquee-track{display:flex;gap:60px;width:max-content;animation:marquee 32s linear infinite;}
.marquee-wrap:hover .marquee-track{animation-play-state:paused;}
.marquee-track img{height:46px;width:auto;object-fit:contain;filter:grayscale(1) opacity(.65);transition:filter .3s;}
.marquee-track img:hover{filter:grayscale(0) opacity(1);}
@keyframes marquee{from{transform:translateX(0);}to{transform:translateX(-50%);}}

/* ---------- areas served ---------- */
.area-chips{display:flex;flex-wrap:wrap;gap:12px;margin-top:40px;}
.area-chips span{
  padding:10px 20px;border-radius:30px;border:1px solid var(--bronze);font-size:12.5px;
  letter-spacing:.5px;color:var(--ink);transition:.3s;
}
.area-chips span:hover{background:var(--gold);border-color:var(--gold);color:#1b1206;}

/* ---------- FAQ ---------- */
.faq-list{max-width:820px;margin-top:40px;}
.faq-item{border-bottom:1px solid rgba(138,90,51,.25);}
.faq-q{
  display:flex;justify-content:space-between;align-items:center;padding:24px 0;cursor:pointer;
  font-size:16px;color:var(--ink);font-weight:500;
}
.faq-q .plus{font-size:20px;color:var(--gold);transition:transform .35s var(--ease);}
.faq-item.open .plus{transform:rotate(45deg);}
.faq-a{max-height:0;overflow:hidden;transition:max-height .45s var(--ease);}
.faq-a p{padding-bottom:24px;font-size:14px;line-height:1.8;}

/* ---------- contact ---------- */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:50px;}
.contact-info-card{
  background:rgba(255,248,232,.06);border:1px solid rgba(212,175,55,.2);border-radius:var(--radius);
  padding:36px;display:grid;gap:22px;
}
.contact-info-card .row{display:flex;gap:16px;align-items:flex-start;}
.contact-info-card .row .icon{font-size:18px;color:var(--gold-light);}
.contact-info-card .row .txt h4{color:var(--cream);font-size:14px;margin-bottom:4px;}
.contact-info-card .row .txt p, .contact-info-card .row .txt a{font-size:13.5px;color:var(--sand);}
.social-row{display:flex;gap:14px;margin-top:6px;}
.social-row a{
  width:38px;height:38px;border-radius:50%;border:1px solid var(--gold);display:flex;
  align-items:center;justify-content:center;color:var(--gold-light);font-size:14px;transition:.3s;
}
.social-row a:hover{background:var(--gold);color:#1b1206;}

form.contact-form{display:grid;gap:16px;}
.contact-form input, .contact-form textarea{
  width:100%;padding:16px 18px;background:rgba(255,248,232,.06);border:1px solid rgba(212,175,55,.25);
  border-radius:10px;color:var(--cream);font-family:'Poppins',sans-serif;font-size:14px;
}
.contact-form input::placeholder, .contact-form textarea::placeholder{color:rgba(233,218,179,.55);}
.contact-form textarea{resize:vertical;min-height:120px;}
.form-msg{font-size:13px;color:var(--gold-light);display:none;}
.form-msg.show{display:block;}
.map-embed{margin-top:50px;border-radius:var(--radius);overflow:hidden;filter:grayscale(.2) sepia(.15);}
.map-embed iframe{width:100%;height:360px;border:0;display:block;}

/* ---------- footer ---------- */
footer{background:#140d07;color:var(--sand);padding:60px 60px 30px;}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:40px;}
.footer-grid h4{color:var(--cream);font-size:14px;margin-bottom:16px;letter-spacing:1px;}
.footer-grid ul{list-style:none;display:grid;gap:10px;}
.footer-grid ul a{font-size:13px;}
.footer-grid ul a:hover{color:var(--gold-light);}
.footer-bottom{
  border-top:1px solid rgba(212,175,55,.15);padding-top:24px;display:flex;justify-content:space-between;
  font-size:12px;flex-wrap:wrap;gap:10px;
}
.footer-social-links{display:flex;flex-wrap:wrap;gap:14px}.footer-social-links a{color:var(--sand);font-size:12px}.footer-social-links a:hover{color:var(--gold-light)}

/* ---------- floating buttons ---------- */
.float-btns{position:fixed;right:28px;bottom:28px;display:grid;gap:14px;z-index:400;}
.float-btn{
  width:54px;height:54px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:22px;color:#fff;box-shadow:0 10px 26px rgba(0,0,0,.3);transition:transform .3s;
}
.float-btn:hover{transform:scale(1.08);}
.wa-btn{background:#25D366;}
.top-btn{background:linear-gradient(120deg,var(--gold),var(--bronze));color:#1b1206;opacity:0;pointer-events:none;transition:opacity .3s;}
.top-btn.show{opacity:1;pointer-events:auto;}

/* ---------- responsive ---------- */
@media(max-width:1080px){
  .services-grid{grid-template-columns:repeat(2,1fr);}
  .gallery-grid{grid-template-columns:repeat(2,1fr);}
  .gallery-grid .g-item:nth-child(1){grid-column:span 2;}
  .pricing-grid,.testi-grid{grid-template-columns:1fr;}
  .about-grid,.contact-grid{grid-template-columns:1fr;}
  .footer-grid{grid-template-columns:1fr 1fr;}
}
@media(max-width:760px){
  header{padding:18px 24px;}
  .section{padding:90px 24px;}
  .hero{padding:0 24px;}
  nav.main-nav{
    position:fixed;top:0;right:-100%;width:72%;height:100vh;background:#140d07;
    flex-direction:column;justify-content:center;align-items:flex-start;gap:28px;padding:40px;
    transition:right .4s var(--ease);
  }
  nav.main-nav.open{right:0;}
  nav.main-nav a{color:var(--cream)!important;font-size:14px;}
  .nav-toggle{display:flex;}
  .header-actions .btn-gold{display:none;}
  .services-grid,.gallery-grid{grid-template-columns:1fr;}
  .gallery-grid .g-item:nth-child(1){grid-column:span 1;grid-row:span 1;}
  .hero-stats{gap:30px;}
  .footer-grid{grid-template-columns:1fr;}
}
</style>

<style>
/* Reference-inspired editorial treatment for Matrix FMS */
:root{--ink:#171717;--cream:#f6f5f1;--sand:#e8e4da;--text-soft:#66686b;--gold:#b39147;--gold-light:#d6bf7a;--bronze:#8b7141;--ease:cubic-bezier(.22,1,.36,1)}
